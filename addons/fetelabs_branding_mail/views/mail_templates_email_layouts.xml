<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="FeteLABS: email footer">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://fetelabs.ai"
               t-att-style="'color: ' + (company.email_secondary_color or '#1FB5A8') + ';'">FeteLABS</a>
        </xpath>
    </template>
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="FeteLABS: light email footer">
        <xpath expr="//a[contains(@href, 'utm_medium=email')]" position="replace">
            <a target="_blank" href="https://fetelabs.ai"
               t-att-style="'color: ' + (company.email_secondary_color or '#1FB5A8') + ';'">FeteLABS</a>
        </xpath>
    </template>
</odoo>
